{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Swiftevo/gcc-telegram-agent/schema/project.schema.json",
  "title": "GCC Public Goods Project Case",
  "type": "object",
  "required": [
    "case_id",
    "schema_version",
    "record_type",
    "title",
    "category",
    "fund_type",
    "public_record",
    "evidence",
    "ai_review_usage",
    "governance"
  ],
  "properties": {
    "case_id": {
      "$ref": "#/$defs/stableId",
      "description": "Stable database id for this case."
    },
    "schema_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "record_type": {
      "type": "string",
      "enum": ["funding_program", "grant_case", "placeholder"],
      "description": "Distinguishes a shared funding programme from an individual funded case and an intentionally empty placeholder."
    },
    "legacy_project_slug": {
      "type": "string",
      "pattern": "^project-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Optional exact slug from the frozen legacy projects.yaml runtime catalog. This is not the canonical case identity."
    },
    "funding_track_id": {
      "$ref": "#/$defs/stableId",
      "description": "For an individual award or activity case, the stable id of exactly one funding track in this database. Omit for umbrella proposals and cases without a verified track relationship."
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Open Source",
        "Community",
        "Event",
        "ETH City Series",
        "Travel Scholarship",
        "Gitcoin"
      ]
    },
    "fund_type": {
      "type": "string",
      "enum": ["public", "special", "unknown"]
    },
    "public_record": {
      "type": "object",
      "required": ["summary", "why_funded", "funding", "execution_events", "links"],
      "properties": {
        "grant_year": {
          "type": ["integer", "null"],
          "description": "Year when GCC approved or recorded the grant."
        },
        "activity_year": {
          "type": ["integer", "null"],
          "description": "Year when the funded activity primarily takes place."
        },
        "language_community": {
          "type": "array",
          "description": "Language or cultural communities served by the case.",
          "items": { "type": "string" }
        },
        "regions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": {
          "type": "string"
        },
        "why_funded": {
          "type": "string"
        },
        "funding": {
          "$ref": "#/$defs/funding"
        },
        "execution_events": {
          "type": "array",
          "description": "Governance and real-world execution events. An empty array means no event has yet been safely modeled.",
          "items": { "$ref": "#/$defs/executionEvent" }
        },
        "program_details": {
          "$ref": "#/$defs/programDetails"
        },
        "public_goods_dimensions": {
          "$ref": "#/$defs/publicGoodsDimensions"
        },
        "impact_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/impactEvidence" }
        },
        "lifecycle_status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "links": {
          "type": "object",
          "properties": {
            "gcc_project_url": { "type": ["string", "null"] },
            "official_website": { "type": ["string", "null"] },
            "announcement_url": { "type": ["string", "null"] },
            "repository_url": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["reference_urls", "snapshots", "grant_application", "voting_record"],
      "properties": {
        "reference_urls": {
          "type": "array",
          "description": "Discovery or reference links. A URL is not citable evidence unless a registered snapshot captures it.",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "snapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot" }
        },
        "grant_application": {
          "$ref": "#/$defs/privateEvidencePointer"
        },
        "voting_record": {
          "$ref": "#/$defs/privateEvidencePointer"
        },
        "vote_summary": {
          "$ref": "#/$defs/voteSummary"
        },
        "raw_data_status": {
          "$ref": "#/$defs/rawDataStatus"
        }
      },
      "additionalProperties": false
    },
    "ai_review_usage": {
      "type": "object",
      "required": ["allowed", "retrieval_text", "screening_dimensions", "cautions"],
      "properties": {
        "allowed": { "type": "boolean" },
        "retrieval_text": { "type": "string" },
        "screening_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mission_fit",
              "public_goods_nature",
              "chinese_community",
              "feasibility",
              "precedent_similarity",
              "risk"
            ]
          }
        },
        "cautions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["visibility", "maintainers", "review_status"],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": ["public", "internal", "private"]
        },
        "license": {
          "type": ["string", "null"]
        },
        "maintainers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_status": {
          "type": "string",
          "enum": ["seed", "draft", "reviewed", "published", "deprecated"]
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "reviewed_by_role": {
          "type": ["string", "null"],
          "description": "Role or governance function that approved the record; do not put private reviewer notes here."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": { "enum": ["reviewed", "published"] }
            },
            "required": ["review_status"]
          },
          "then": {
            "required": ["reviewed_at", "reviewed_by_role"],
            "properties": {
              "reviewed_at": { "type": "string", "format": "date" },
              "reviewed_by_role": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ai_review_usage": {
            "properties": { "allowed": { "const": true } },
            "required": ["allowed"]
          }
        },
        "required": ["ai_review_usage"]
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "visibility": { "const": "public" },
              "review_status": { "enum": ["reviewed", "published"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "record_type": { "const": "placeholder" } },
        "required": ["record_type"]
      },
      "then": {
        "properties": {
          "ai_review_usage": {
            "properties": { "allowed": { "const": false } }
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceSnapshotIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "funding": {
      "type": "object",
      "required": [
        "requested",
        "governance_approved",
        "disbursed",
        "total_budget",
        "per_person_cap"
      ],
      "properties": {
        "requested": { "$ref": "#/$defs/amountFact" },
        "governance_approved": { "$ref": "#/$defs/amountFact" },
        "disbursed": { "$ref": "#/$defs/amountFact" },
        "total_budget": { "$ref": "#/$defs/amountFact" },
        "per_person_cap": { "$ref": "#/$defs/amountFact" },
        "disbursement_type": {
          "type": ["string", "null"],
          "enum": [
            "milestone",
            "one_time",
            "retroactive",
            "reimbursement",
            "matching_pool",
            "unknown",
            null
          ]
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "factStatus": {
      "type": "string",
      "enum": [
        "source_reported",
        "owner_confirmed",
        "verified",
        "pending_reconciliation",
        "unknown",
        "not_applicable"
      ]
    },
    "amountFact": {
      "type": "object",
      "required": ["amount", "currency", "status", "source_snapshot_ids", "notes"],
      "properties": {
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/factStatus" },
        "source_snapshot_ids": { "$ref": "#/$defs/sourceSnapshotIds" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "amount": { "type": "number" } },
            "required": ["amount"]
          },
          "then": {
            "properties": {
              "currency": { "type": "string", "minLength": 1 },
              "source_snapshot_ids": { "minItems": 1 }
            }
          },
          "else": {
            "properties": { "currency": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["unknown", "not_applicable"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "amount": { "type": "null" },
              "currency": { "type": "null" }
            }
          }
        }
      ]
    },
    "executionEvent": {
      "type": "object",
      "required": ["event_type", "date", "amount", "currency", "status", "source_snapshot_ids", "notes"],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "governance_decision",
            "disbursement",
            "milestone_acceptance",
            "milestone_unlock",
            "activity_completed",
            "report_submitted"
          ]
        },
        "date": { "type": ["string", "null"], "format": "date" },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "milestone_name": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/factStatus" },
        "source_snapshot_ids": { "$ref": "#/$defs/sourceSnapshotIds" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "amount": { "type": "number" } },
            "required": ["amount"]
          },
          "then": {
            "properties": {
              "currency": { "type": "string", "minLength": 1 },
              "source_snapshot_ids": { "minItems": 1 }
            }
          },
          "else": {
            "properties": { "currency": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["unknown", "not_applicable"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "amount": { "type": "null" },
              "currency": { "type": "null" }
            }
          }
        }
      ]
    },
    "programDetails": {
      "type": "object",
      "properties": {
        "start_date": { "type": ["string", "null"] },
        "end_date": { "type": ["string", "null"] },
        "application_deadline": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "eligibility": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selection_criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/weightedCriterion" }
        },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "funding_tracks": {
          "type": "array",
          "description": "Sub-programs or funding tracks under an umbrella case.",
          "items": { "$ref": "#/$defs/fundingTrack" }
        },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "fundingTrack": {
      "type": "object",
      "required": ["track_id", "name", "source_snapshot_ids", "total_pool", "min_grant", "max_grant"],
      "properties": {
        "track_id": {
          "$ref": "#/$defs/stableId",
          "description": "Stable id referenced by an individual case's funding_track_id."
        },
        "name": { "type": "string" },
        "source_snapshot_ids": {
          "$ref": "#/$defs/sourceSnapshotIds",
          "description": "Source for the track's announced rules; not evidence of an individual award or payment."
        },
        "track_type": {
          "type": ["string", "null"],
          "enum": ["university_group", "city_event", "travel_scholarship", "open_source", "other", null]
        },
        "total_pool": { "$ref": "#/$defs/amountFact" },
        "min_grant": { "$ref": "#/$defs/amountFact" },
        "max_grant": { "$ref": "#/$defs/amountFact" },
        "slot_limit": { "type": ["integer", "null"] },
        "application_mode": { "type": ["string", "null"] },
        "application_url": { "type": ["string", "null"] },
        "eligibility": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported_uses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": ["string", "null"],
          "enum": ["approved", "active", "completed", "unknown", null]
        },
        "child_records_status": {
          "type": ["string", "null"],
          "enum": ["none", "pending_import", "partial", "complete", "unknown", null]
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "weightedCriterion": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "weight": { "type": ["number", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": ["name", "unlock_amount"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "unlock_amount": { "$ref": "#/$defs/amountFact" },
        "unlock_percentage": { "type": ["number", "null"] },
        "expected_completion": { "type": ["string", "null"] },
        "status": {
          "type": ["string", "null"],
          "enum": ["planned", "completed", "unknown", null]
        }
      },
      "additionalProperties": false
    },
    "publicGoodsDimensions": {
      "type": "object",
      "properties": {
        "open_source": { "$ref": "#/$defs/dimensionAssessment" },
        "accessibility": { "$ref": "#/$defs/dimensionAssessment" },
        "knowledge_transfer": { "$ref": "#/$defs/dimensionAssessment" },
        "community_impact": { "$ref": "#/$defs/dimensionAssessment" },
        "non_excludable": { "$ref": "#/$defs/dimensionAssessment" },
        "non_rivalrous": { "$ref": "#/$defs/dimensionAssessment" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "dimensionAssessment": {
      "type": "object",
      "required": ["value", "source_snapshot_ids"],
      "properties": {
        "value": {
          "type": ["string", "boolean", "null"],
          "enum": [true, false, "high", "medium", "low", "unknown", null]
        },
        "notes": { "type": ["string", "null"] },
        "source_snapshot_ids": { "$ref": "#/$defs/sourceSnapshotIds" }
      },
      "additionalProperties": false
    },
    "impactEvidence": {
      "type": "object",
      "required": ["type", "description", "source_snapshot_ids"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "participation",
            "deliverable",
            "adoption",
            "education",
            "community",
            "open_source_output",
            "funding_access",
            "other"
          ]
        },
        "description": { "type": "string" },
        "metric": { "type": ["string", "null"] },
        "value": { "type": ["string", "number", "null"] },
        "source_snapshot_ids": { "$ref": "#/$defs/sourceSnapshotIds" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lifecycleStatus": {
      "type": "object",
      "properties": {
        "grant_status": {
          "type": ["string", "null"],
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "funded",
            "completed",
            "unknown",
            null
          ]
        },
        "delivery_status": {
          "type": ["string", "null"],
          "enum": [
            "not_started",
            "in_progress",
            "completed",
            "retroactive",
            "unknown",
            null
          ]
        },
        "reporting_status": {
          "type": ["string", "null"],
          "enum": [
            "not_required",
            "expected",
            "submitted",
            "missing",
            "unknown",
            null
          ]
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "voteSummary": {
      "type": "object",
      "required": ["source_snapshot_ids"],
      "properties": {
        "platform": {
          "type": ["string", "null"],
          "enum": ["snapshot", "manual", "internal", "unknown", null]
        },
        "proposal_id": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/voteChoice" }
        },
        "total_score": { "type": ["number", "null"] },
        "source_snapshot_ids": { "$ref": "#/$defs/sourceSnapshotIds" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "voteChoice": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "score": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "rawDataStatus": {
      "type": "object",
      "required": ["status", "source_snapshot_ids"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["captured", "manual", "pending", "unavailable", "not_applicable"]
        },
        "verification": {
          "type": ["string", "null"],
          "enum": ["api", "official_site", "user_supplied", "unverified", "not_applicable", null]
        },
        "storage_uri": { "type": ["string", "null"] },
        "source_snapshot_ids": { "$ref": "#/$defs/sourceSnapshotIds" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "source_type",
        "access_level",
        "storage_uri",
        "checksum",
        "processing"
      ],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/stableId" },
        "captured_at": { "type": ["string", "null"] },
        "source_type": {
          "type": "string",
          "enum": [
            "gcc_project_page",
            "grant_application",
            "committee_vote",
            "snapshot_proposal",
            "event_website",
            "social_post",
            "public_announcement",
            "project_website",
            "repository",
            "media",
            "other"
          ]
        },
        "access_level": {
          "type": "string",
          "enum": ["public", "internal", "private", "redacted"]
        },
        "source_url": { "type": ["string", "null"] },
        "storage_uri": { "type": "string", "minLength": 1 },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "processing": { "$ref": "#/$defs/sourceProcessing" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "sourceProcessing": {
      "type": "object",
      "required": [
        "handling_profile",
        "sanitization_status",
        "review_status",
        "allowed_uses",
        "policy_version"
      ],
      "properties": {
        "handling_profile": {
          "type": "string",
          "enum": ["public_source_extract", "sanitized_public_application"]
        },
        "sanitization_status": {
          "type": "string",
          "enum": ["pending", "automated_checked", "human_reviewed"]
        },
        "review_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["evidence_only", "bot_qa", "application_review"]
          }
        },
        "policy_version": { "const": "1.0" },
        "reviewed_at": { "type": ["string", "null"], "format": "date" },
        "reviewed_by_role": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "review_status": { "const": "approved" } },
            "required": ["review_status"]
          },
          "then": {
            "required": ["reviewed_at", "reviewed_by_role"],
            "properties": {
              "reviewed_at": { "type": "string", "format": "date" },
              "reviewed_by_role": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "privateEvidencePointer": {
      "type": "object",
      "required": ["status", "access_level"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unknown", "expected", "available", "redacted", "not_applicable"]
        },
        "access_level": {
          "type": "string",
          "enum": ["public", "internal", "private", "redacted"]
        },
        "document_ref": { "type": ["string", "null"] },
        "snapshot_id": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
