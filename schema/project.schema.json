{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Swiftevo/gcc-telegram-agent/schema/project.schema.json",
  "title": "GCC Public Goods Project Case",
  "type": "object",
  "required": [
    "case_id",
    "schema_version",
    "title",
    "category",
    "fund_type",
    "public_record",
    "evidence",
    "ai_review_usage"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Stable database id for this case."
    },
    "schema_version": {
      "type": "string"
    },
    "canonical_project_id": {
      "type": "string",
      "description": "Optional link to the legacy projects.yaml slug or future canonical id."
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Open Source",
        "Community",
        "Event",
        "ETH City Series",
        "Travel Scholarship",
        "Gitcoin"
      ]
    },
    "fund_type": {
      "type": "string",
      "enum": ["public", "special", "unknown"]
    },
    "public_record": {
      "type": "object",
      "required": ["summary", "why_funded", "links"],
      "properties": {
        "amount_usd": {
          "deprecated": true,
          "description": "Legacy simple amount field. Prefer funding.* for new records.",
          "type": ["number", "null"]
        },
        "grant_year": {
          "type": ["integer", "null"],
          "description": "Year when GCC approved or recorded the grant."
        },
        "activity_year": {
          "type": ["integer", "null"],
          "description": "Year when the funded activity primarily takes place."
        },
        "language_community": {
          "type": "array",
          "description": "Language or cultural communities served by the case.",
          "items": { "type": "string" }
        },
        "regions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": {
          "type": "string"
        },
        "why_funded": {
          "type": "string"
        },
        "funding": {
          "$ref": "#/$defs/funding"
        },
        "program_details": {
          "$ref": "#/$defs/programDetails"
        },
        "public_goods_dimensions": {
          "$ref": "#/$defs/publicGoodsDimensions"
        },
        "impact_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/impactEvidence" }
        },
        "lifecycle_status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "links": {
          "type": "object",
          "properties": {
            "gcc_project_url": { "type": ["string", "null"] },
            "official_website": { "type": ["string", "null"] },
            "repository_url": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_urls", "snapshots", "grant_application", "voting_record"],
      "properties": {
        "source_urls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "snapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshot" }
        },
        "grant_application": {
          "$ref": "#/$defs/privateEvidencePointer"
        },
        "voting_record": {
          "$ref": "#/$defs/privateEvidencePointer"
        },
        "vote_summary": {
          "$ref": "#/$defs/voteSummary"
        },
        "raw_data_status": {
          "$ref": "#/$defs/rawDataStatus"
        }
      },
      "additionalProperties": false
    },
    "ai_review_usage": {
      "type": "object",
      "required": ["allowed", "retrieval_text", "screening_dimensions", "cautions"],
      "properties": {
        "allowed": { "type": "boolean" },
        "retrieval_text": { "type": "string" },
        "screening_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mission_fit",
              "public_goods_nature",
              "chinese_community",
              "feasibility",
              "precedent_similarity",
              "risk"
            ]
          }
        },
        "cautions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "visibility": {
          "type": "string",
          "enum": ["public", "internal", "private"]
        },
        "license": {
          "type": ["string", "null"]
        },
        "maintainers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_status": {
          "type": "string",
          "enum": ["seed", "draft", "reviewed", "published", "deprecated"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "funding": {
      "type": "object",
      "properties": {
        "requested_amount_usd": { "type": ["number", "null"] },
        "approved_amount_usd": { "type": ["number", "null"] },
        "total_budget_usd": { "type": ["number", "null"] },
        "per_person_cap_usd": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "disbursement_type": {
          "type": ["string", "null"],
          "enum": [
            "milestone",
            "one_time",
            "retroactive",
            "reimbursement",
            "matching_pool",
            "unknown",
            null
          ]
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "programDetails": {
      "type": "object",
      "properties": {
        "start_date": { "type": ["string", "null"] },
        "end_date": { "type": ["string", "null"] },
        "application_deadline": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "eligibility": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selection_criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/weightedCriterion" }
        },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "weightedCriterion": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "weight": { "type": ["number", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "unlock_amount_usd": { "type": ["number", "null"] },
        "unlock_percentage": { "type": ["number", "null"] },
        "expected_completion": { "type": ["string", "null"] },
        "status": {
          "type": ["string", "null"],
          "enum": ["planned", "completed", "unknown", null]
        }
      },
      "additionalProperties": false
    },
    "publicGoodsDimensions": {
      "type": "object",
      "properties": {
        "open_source": { "$ref": "#/$defs/dimensionAssessment" },
        "accessibility": { "$ref": "#/$defs/dimensionAssessment" },
        "knowledge_transfer": { "$ref": "#/$defs/dimensionAssessment" },
        "community_impact": { "$ref": "#/$defs/dimensionAssessment" },
        "non_excludable": { "$ref": "#/$defs/dimensionAssessment" },
        "non_rivalrous": { "$ref": "#/$defs/dimensionAssessment" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "dimensionAssessment": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": ["string", "boolean", "null"],
          "enum": [true, false, "high", "medium", "low", "unknown", null]
        },
        "notes": { "type": ["string", "null"] },
        "source_snapshot_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "impactEvidence": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "participation",
            "deliverable",
            "adoption",
            "education",
            "community",
            "open_source_output",
            "funding_access",
            "other"
          ]
        },
        "description": { "type": "string" },
        "metric": { "type": ["string", "null"] },
        "value": { "type": ["string", "number", "null"] },
        "source_snapshot_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lifecycleStatus": {
      "type": "object",
      "properties": {
        "grant_status": {
          "type": ["string", "null"],
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "funded",
            "completed",
            "unknown",
            null
          ]
        },
        "delivery_status": {
          "type": ["string", "null"],
          "enum": [
            "not_started",
            "in_progress",
            "completed",
            "retroactive",
            "unknown",
            null
          ]
        },
        "reporting_status": {
          "type": ["string", "null"],
          "enum": [
            "not_required",
            "expected",
            "submitted",
            "missing",
            "unknown",
            null
          ]
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "voteSummary": {
      "type": "object",
      "properties": {
        "platform": {
          "type": ["string", "null"],
          "enum": ["snapshot", "manual", "internal", "unknown", null]
        },
        "proposal_id": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/voteChoice" }
        },
        "total_score": { "type": ["number", "null"] },
        "source_snapshot_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "voteChoice": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "score": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "rawDataStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["captured", "manual", "pending", "unavailable", "not_applicable"]
        },
        "verification": {
          "type": ["string", "null"],
          "enum": ["api", "official_site", "user_supplied", "unverified", "not_applicable", null]
        },
        "storage_uri": { "type": ["string", "null"] },
        "source_snapshot_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "source_type", "access_level"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "captured_at": { "type": ["string", "null"] },
        "source_type": {
          "type": "string",
          "enum": [
            "gcc_project_page",
            "grant_application",
            "committee_vote",
            "snapshot_proposal",
            "event_website",
            "social_post",
            "project_website",
            "repository",
            "media",
            "other"
          ]
        },
        "access_level": {
          "type": "string",
          "enum": ["public", "internal", "private", "redacted"]
        },
        "source_url": { "type": ["string", "null"] },
        "storage_uri": { "type": ["string", "null"] },
        "checksum": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "privateEvidencePointer": {
      "type": "object",
      "required": ["status", "access_level"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unknown", "expected", "available", "redacted", "not_applicable"]
        },
        "access_level": {
          "type": "string",
          "enum": ["public", "internal", "private", "redacted"]
        },
        "document_ref": { "type": ["string", "null"] },
        "snapshot_id": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
